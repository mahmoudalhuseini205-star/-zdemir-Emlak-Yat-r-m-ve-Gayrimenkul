---
import { site } from '../site';

// Outline brand glyphs in lucide's style (lucide 1.x dropped brand icons).
interface Props {
  label: string;
  class?: string;
  itemClass?: string;
}
const { label, class: className = '', itemClass = '' } = Astro.props;

const items = [
  {
    href: site.instagram,
    name: 'Instagram',
    icon: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"/>',
  },
  {
    href: site.facebook,
    name: 'Facebook',
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
];
---

<ul class={`socials flex gap-2 ${className}`} aria-label={label}>
  {
    items.map((it, i) => (
      <li style={`--i:${i}`}>
        <a
          href={it.href}
          target="_blank"
          rel="noopener"
          aria-label={it.name}
          class={`social-link w-11 h-11 inline-flex items-center justify-center border ${itemClass}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5"
            aria-hidden="true"
            set:html={it.icon}
          />
        </a>
      </li>
    ))
  }
</ul>
