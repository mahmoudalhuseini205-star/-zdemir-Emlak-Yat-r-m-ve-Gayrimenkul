---
import { t, waLink, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<a
  href={waLink(s.whatsapp.message)}
  target="_blank"
  rel="noopener"
  data-fab
  class="fab fixed right-4 z-40 w-14 h-14 inline-flex items-center justify-center rounded-full bg-[#25D366] text-ink shadow-[0_0_0_5px_rgb(37_211_102/0.22),0_4px_10px_-4px_rgb(0_0_0/0.3)] transition-transform duration-300 hover:scale-105"
  style="bottom: calc(1rem + env(safe-area-inset-bottom)); right: calc(1rem + env(safe-area-inset-right));"
>
  <span class="sr-only">{s.whatsapp.label}</span>
  <svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7" aria-hidden="true">
    <path
      d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3Z"
    ></path>
    <path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"
    ></path>
  </svg>
</a>

<script>
  // Phones only (the CSS is in global.css, below md): the FAB tucks away while something already offers the same
  // action and its right edge would sit on top of it: the hero's own WhatsApp button, and the request form
  // (whose wide "Devam" / send buttons run under the FAB's corner).
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  if (fab && 'IntersectionObserver' in window) {
    const away = new Set<Element>();
    const watch = (el: Element) =>
      new IntersectionObserver(([e]) => {
        e.isIntersecting ? away.add(el) : away.delete(el);
        fab.toggleAttribute('data-away', away.size > 0);
      }).observe(el);

    // A sentinel the height of --fab-after at the top of the page: "still on the hero".
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:var(--fab-after, 4rem);pointer-events:none';
    sentinel.setAttribute('aria-hidden', 'true');
    document.body.prepend(sentinel);
    watch(sentinel);

    const form = document.querySelector('[data-request]');
    if (form) watch(form);
  }
</script>
