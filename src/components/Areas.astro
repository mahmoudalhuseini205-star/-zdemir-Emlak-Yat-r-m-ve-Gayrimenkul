---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import areas from '../data/areas.json';
import { t, waLink, fill, type Lang } from '../site';
import { placeholder } from '../lqip';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/areas/*.webp', { eager: true });

// TODO(client): confirm areas — this list is provisional.
const cards = await Promise.all(
  areas.map(async (a) => {
    const src = files[`../assets/areas/${a.image}`]?.default ?? null;
    return { ...a, src, ph: src ? await placeholder(src) : undefined, text: a[lang], alt: lang === 'tr' ? a.altTr : a.altEn };
  })
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- A swipeable scroll-snap row of area panels. -->
<section id="bolgeler" class="areas-sec section-y bg-surface scroll-mt-20">
  <div class="container-page flex flex-wrap items-end justify-between gap-6">
    <div>
      <h2 class="max-w-2xl" data-reveal>{s.areas.title}</h2>
      <p class="mt-4 max-w-xl text-graphite" data-reveal>{s.areas.intro}</p>
    </div>
  </div>

  <div class="areas-viewport mt-10 overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <ul class="areas-track flex w-max gap-4 md:gap-6 px-4 sm:px-6 lg:px-[max(1.5rem,calc((100vw-1280px)/2+1.5rem))]" data-areas-track>
      {
        cards.map((area, i) => (
          <li class="area-panel group relative shrink-0 snap-center overflow-hidden bg-ink text-white" style={area.ph}>
            {area.src ? (
              <div class="area-media absolute inset-y-0 -inset-x-[12%]">
                <Picture
                  src={area.src}
                  alt={area.alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[600, 1000, 1400]}
                  sizes="(min-width: 1024px) 70vw, 85vw"
                  class="w-full h-full object-cover"
                  quality={60}
                  loading="lazy"
                />
              </div>
            ) : (
              /* TODO(image): area {area.slug} */
              <div class="absolute inset-0 flex items-center justify-center bg-paper text-graphite text-xs uppercase tracking-[0.2em]">
                {s.common.placeholderLabel}
              </div>
            )}
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to top, rgb(17 19 24 / .88) 0%, rgb(17 19 24 / .25) 55%, rgb(17 19 24 / .05) 100%);"
            />
            <span class="absolute top-5 left-6 md:top-8 md:left-10 font-display text-white/70 text-lg" aria-hidden="true">{pad(i + 1)}</span>
            <div class="area-copy on-photo absolute inset-x-0 bottom-0 p-6 md:p-10">
              <h3 class="font-display leading-none text-[clamp(2.25rem,6vw,5rem)]">{area.name}</h3>
              <p class="mt-3 max-w-md text-sm md:text-base text-white/85">{area.text}</p>
              <a
                href={waLink(fill(s.whatsapp.areaMessage, { area: area.name }))}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex items-center h-11 text-sm font-medium text-white link-line"
              >
                {s.areas.ask}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 ml-2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="container-page mt-8 text-xs text-graphite" data-reveal>{s.areas.todo}</p>
</section>

<style>
  .area-panel {
    width: 85vw;
    height: clamp(20rem, 58svh, 36rem);
  }
  @media (min-width: 1024px) {
    .area-panel {
      width: min(68vw, 62rem);
    }
  }
</style>
