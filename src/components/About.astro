---
import Placeholder from './Placeholder.astro';
import { t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<section id="hakkimizda" class="section-y bg-paper scroll-mt-20">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow">{s.about.eyebrow}</p>
      <h2 class="mt-4">{s.about.title}</h2>
      <p class="mt-6 text-graphite">{s.about.bio}</p>
      <p class="mt-2 text-xs text-graphite">{s.about.bioTodo}</p>

      <div class="mt-8 flex items-center gap-4">
        <!-- TODO(image): founder portrait — never use a stock photo of a person here. -->
        <Placeholder label={s.about.portraitTodo} class="w-24 h-24 shrink-0 gap-1" />
        <div>
          <p class="font-display text-2xl">{s.about.founderName}</p>
          <p class="text-sm text-graphite">{s.about.founderRole}</p>
        </div>
      </div>
    </div>

    <div class="overflow-hidden aspect-[4/3] lg:col-span-6 lg:col-start-7" data-reveal="clip">
      <!-- TODO(client): office exterior photo (see CLIENT.md shot list #3). -->
      <Placeholder label={s.about.officeTodo} class="w-full h-full" />
    </div>
  </div>
</section>
