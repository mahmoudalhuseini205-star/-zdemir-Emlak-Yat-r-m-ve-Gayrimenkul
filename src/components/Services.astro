---
import { t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

// Lucide paths: home, key-round, calculator, trending-up
const icons = [
  'M3 10.5 12 3l9 7.5M5.5 9.3V20a1 1 0 0 0 1 1H10v-6h4v6h3.5a1 1 0 0 0 1-1V9.3',
  'M15.5 3a5.5 5.5 0 1 0-4.9 8L10 11.6 3 18.6V21h3l1-1v-2h2v-2h2l1.4-1.4.6-.6a5.5 5.5 0 0 0 2.5-11ZM16.5 7.5h.01',
  'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM9 7h6M9 11h.01M12 11h.01M15 11h.01M9 15h.01M12 15h.01M15 15h3',
  'M3 17 9.5 10.5l3.5 3.5L21 6M21 6h-5M21 6v5',
];
---

<section id="hizmetler" class="section-y bg-surface scroll-mt-20">
  <!-- Sticky heading on the left, service rows scroll past it on the right. Stacks on mobile. -->
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
      <h2 data-reveal>{s.services.title}</h2>
      <p class="mt-5 max-w-md text-graphite" data-reveal>{s.services.intro}</p>
    </div>

    <ul class="lg:col-span-7 border-t border-line">
      {
        s.services.items.map((item, i) => (
          <li class="service-row group relative border-b border-line py-8 sm:py-10 grid grid-cols-[auto_1fr] gap-6 sm:gap-8" data-reveal>
            <span
              class="halo w-14 h-14 sm:w-16 sm:h-16 inline-flex items-center justify-center border border-line bg-paper text-accent transition-[color,background-color,border-color,box-shadow] duration-500 group-hover:shadow-[0_0_0_7px_var(--halo)] group-hover:bg-brand group-hover:border-brand group-hover:text-white"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-7 h-7 sm:w-8 sm:h-8 transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-110"
              >
                <path d={icons[i]} />
              </svg>
            </span>
            <div>
              <h3 class="text-3xl transition-colors duration-300 group-hover:text-accent-strong">{item.title}</h3>
              <p class="mt-3 max-w-md text-graphite">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* A brand line runs across the row's bottom border on hover. */
  .service-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-accent-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out);
  }
  .service-row:hover::after {
    transform: scaleX(1);
  }
</style>
