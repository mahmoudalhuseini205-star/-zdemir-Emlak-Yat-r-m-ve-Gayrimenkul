---
// Recognisable marks for the listing portals (sahibinden: yellow tile + "s"; hepsiemlak: red roof).
// Their brand colours are allowed here only, like WhatsApp green on WhatsApp buttons.
interface Props {
  name: 'sahibinden' | 'hepsiemlak';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

{
  name === 'sahibinden' ? (
    <svg viewBox="0 0 40 40" class={className} aria-hidden="true">
      <rect width="40" height="40" rx="6" fill="#FFE800" />
      <text x="20" y="29.5" text-anchor="middle" font-family="Montserrat, system-ui, sans-serif" font-weight="800" font-size="27" fill="#000">s</text>
    </svg>
  ) : (
    <svg viewBox="0 0 40 40" class={className} aria-hidden="true">
      <rect x=".5" y=".5" width="39" height="39" rx="6" fill="#fff" stroke="#000" stroke-opacity=".12" />
      <path d="M8 22 20 11l12 11" fill="none" stroke="#E4312B" stroke-width="5" stroke-linecap="square" />
      <path d="M13 21v9h14v-9" fill="none" stroke="#E4312B" stroke-width="3" />
    </svg>
  )
}
