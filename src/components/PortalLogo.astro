---
// Recognisable marks for the listing portals (hepsiemlak: red roof; Emlakjet: green house + pin).
// Their brand colours are allowed here only, like WhatsApp green on WhatsApp buttons.
interface Props {
  name: 'hepsiemlak' | 'emlakjet';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

{
  name === 'emlakjet' ? (
    <svg viewBox="0 0 40 40" class={className} aria-hidden="true">
      <rect x=".5" y=".5" width="39" height="39" rx="6" fill="#fff" stroke="#000" stroke-opacity=".12" />
      <path d="M12.5 29h-1.5a2 2 0 0 1-2-2V17.5a3 3 0 0 1 1.3-2.5L20 8.5l9.7 6.5a3 3 0 0 1 1.3 2.5V27a2 2 0 0 1-2 2h-1.5" fill="none" stroke="#09E524" stroke-width="3" stroke-linejoin="round" />
      <path d="M20 33.5s-5-6.2-5-9.5a5 5 0 0 1 10 0c0 3.3-5 9.5-5 9.5z" fill="#09E524" />
      <circle cx="20" cy="24" r="1.8" fill="#fff" />
    </svg>
  ) : (
    <svg viewBox="0 0 40 40" class={className} aria-hidden="true">
      <rect x=".5" y=".5" width="39" height="39" rx="6" fill="#fff" stroke="#000" stroke-opacity=".12" />
      <path d="M8 22 20 11l12 11" fill="none" stroke="#E4312B" stroke-width="5" stroke-linecap="square" />
      <path d="M13 21v9h14v-9" fill="none" stroke="#E4312B" stroke-width="3" />
    </svg>
  )
}
