---
// Recognisable mark for the listing portal (sahibinden: black "s" on its yellow square).
// Its brand colour is allowed here only, like WhatsApp green on WhatsApp buttons.
interface Props {
  name: 'sahibinden';
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 40 40" class={className} aria-hidden="true">
  <rect x=".5" y=".5" width="39" height="39" rx="6" fill="#FFE800" stroke="#000" stroke-opacity=".12" />
  <text x="20" y="28.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="25" font-weight="700" fill="#000">s</text>
</svg>
