---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, waLink, fill, type Lang } from '../site';

interface Card {
  slug: string;
  copy: { title: string; desc: string };
  images: { src: ImageMetadata | null; alt: string; credit: string; source: string }[];
}
interface Props {
  lang: Lang;
  cards: Card[];
}
const { lang, cards } = Astro.props;
const s = t(lang);
const m = s.projects.modal;
---

<dialog
  data-gallery-dialog
  aria-label={s.projects.eyebrow}
  class="m-auto max-w-none p-0 bg-surface text-fg"
>
  <div class="sticky top-0 z-10 bg-surface flex items-center justify-between gap-4 px-4 sm:px-6 h-16 border-b border-line">
    <p class="font-display text-xl truncate" data-gallery-title></p>
    <button
      type="button"
      data-gallery-close
      class="shrink-0 w-11 h-11 inline-flex items-center justify-center"
      aria-label={m.close}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-6 h-6" aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>

  {
    cards.map((card) => (
      <div data-gallery-panel={card.slug} hidden>
        <div class="relative">
          <div
            data-strip
            class="flex overflow-x-auto snap-x snap-mandatory motion-safe:scroll-smooth overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          >
            {card.images.map((img) => (
              <figure class="min-w-full snap-center">
                <Image
                  src={img.src!}
                  alt={img.alt}
                  widths={[800, 1200]}
                  sizes="(min-width: 1024px) 68rem, 100vw"
                  class="w-full aspect-[3/2] max-h-[calc(100svh-13rem)] object-cover bg-paper"
                  quality={70}
                  loading="lazy"
                />
                <figcaption class="px-4 sm:px-6 py-2 text-xs text-graphite">
                  {m.photoCredit}: {img.credit} ·{' '}
                  <a href={img.source} target="_blank" rel="noopener" class="underline">
                    Pexels
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>

          <button
            type="button"
            data-strip-prev
            aria-label={m.prev}
            class="absolute left-2 top-1/3 w-11 h-11 inline-flex items-center justify-center bg-surface/90 border border-line halo"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            data-strip-next
            aria-label={m.next}
            class="absolute right-2 top-1/3 w-11 h-11 inline-flex items-center justify-center bg-surface/90 border border-line halo"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>
          <p
            class="absolute right-2 bottom-12 bg-ink/80 text-white text-xs px-2 py-1 tabular-nums"
            data-strip-counter
            aria-live="polite"
          >
            {fill(m.counter, { current: 1, total: card.images.length })}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-4 sm:px-6 py-5 border-t border-line">
          <p class="text-sm text-graphite">{card.copy.desc}</p>
          <a
            href={waLink(fill(s.whatsapp.projectMessage, { title: card.copy.title }))}
            target="_blank"
            rel="noopener"
            class="shrink-0 inline-flex items-center justify-center min-h-12 px-4 py-2 sm:px-6 text-center leading-snug bg-[#25D366] text-ink font-medium"
            >{m.whatsapp}</a
          >
        </div>
      </div>
    ))
  }
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const titleEl = document.querySelector<HTMLElement>('[data-gallery-title]');
  let opener: HTMLElement | null = null;

  function showPanel(slug: string) {
    document.querySelectorAll<HTMLElement>('[data-gallery-panel]').forEach((p) => {
      p.hidden = p.dataset.galleryPanel !== slug;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open-gallery]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog) return;
      opener = btn;
      showPanel(btn.dataset.openGallery!);
      if (titleEl) titleEl.textContent = btn.querySelector('.font-display')?.textContent ?? '';
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    });
  });

  dialog?.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());

  // Backdrop click: the dialog element itself only receives clicks outside its content box.
  // Press and release must both land there, so a drag that ends on the backdrop doesn't close it.
  let downOnBackdrop = false;
  dialog?.addEventListener('pointerdown', (e) => {
    downOnBackdrop = e.target === dialog;
  });
  // A press that starts on the backdrop but is released inside the dialog is not a backdrop click.
  dialog?.addEventListener('pointerup', (e) => {
    if (e.target !== dialog) downOnBackdrop = false;
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog && downOnBackdrop) dialog.close();
    downOnBackdrop = false;
  });

  dialog?.addEventListener('close', () => {
    document.body.style.overflow = '';
    opener?.focus();
  });

  // Scroll-snap strip controls, one set per panel.
  document.querySelectorAll<HTMLElement>('[data-gallery-panel]').forEach((panel) => {
    const strip = panel.querySelector<HTMLElement>('[data-strip]');
    const counter = panel.querySelector<HTMLElement>('[data-strip-counter]');
    if (!strip) return;
    const total = strip.children.length;
    const template = counter?.textContent?.trim() ?? '';

    const current = () => Math.round(strip.scrollLeft / strip.clientWidth);
    // Index a button-driven smooth scroll is heading to, so rapid taps each step exactly one photo.
    let target: number | null = null;
    let shown = -1;

    const update = () => {
      const index = current();
      if (index === target) target = null;
      // Only write when the photo changes: this text sits in an aria-live region.
      if (index === shown) return;
      shown = index;
      if (counter) counter.textContent = template.replace(/^\d+/, String(index + 1));
    };
    const go = (dir: number) => {
      target = Math.min(Math.max((target ?? current()) + dir, 0), total - 1);
      strip.scrollTo({ left: target * strip.clientWidth });
    };
    const manual = () => {
      target = null;
    };

    panel.querySelector('[data-strip-prev]')?.addEventListener('click', () => go(-1));
    panel.querySelector('[data-strip-next]')?.addEventListener('click', () => go(1));
    strip.addEventListener('scroll', update, { passive: true });
    // A manual swipe/wheel or a finished scroll hands control back to the real position.
    strip.addEventListener('pointerdown', manual, { passive: true });
    strip.addEventListener('wheel', manual, { passive: true });
    strip.addEventListener('scrollend', manual);
    dialog?.addEventListener('close', manual);
    // Arrow keys page through the visible panel's photos.
    dialog?.addEventListener('keydown', (e) => {
      if (panel.hidden || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
      e.preventDefault();
      go(e.key === 'ArrowRight' ? 1 : -1);
    });
  });
</script>

<style>
  /* Notch-safe width; calc() inside a Tailwind arbitrary value can't take env() reliably. */
  [data-gallery-dialog] {
    width: min(100vw - 2rem - env(safe-area-inset-left) - env(safe-area-inset-right), 68rem);
  }
  /* Open/close: fade + lift. Gated on `overlay` support (Chromium); other browsers open and close instantly. */
  @supports (overlay: auto) {
    [data-gallery-dialog] {
      transition:
        opacity 400ms var(--ease-out),
        transform 500ms var(--ease-out),
        overlay 400ms allow-discrete,
        display 400ms allow-discrete;
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    [data-gallery-dialog][open] {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      [data-gallery-dialog][open] {
        opacity: 0;
        transform: translateY(24px) scale(0.98);
      }
    }
    [data-gallery-dialog]::backdrop {
      transition: background-color 400ms, overlay 400ms allow-discrete, display 400ms allow-discrete;
      background-color: rgb(17 19 24 / 0);
    }
    [data-gallery-dialog][open]::backdrop {
      background-color: rgb(17 19 24 / 0.85);
    }
    @starting-style {
      [data-gallery-dialog][open]::backdrop {
        background-color: rgb(17 19 24 / 0);
      }
    }
  }
  /* Without the animated rules above the backdrop still needs its dim. */
  @supports not (overlay: auto) {
    [data-gallery-dialog]::backdrop {
      background-color: rgb(17 19 24 / 0.85);
    }
  }
</style>
