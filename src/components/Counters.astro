---
import { site, t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const locale = lang === 'tr' ? 'tr-TR' : 'en-US';

// Only figures verified in CLIENT.md. Everything else stays out.
// TODO(client): real stats — properties sold/rented, clients, active listings.
const items = [
  { value: site.yearsExperience, suffix: '+', label: s.counters.years },
  { value: site.instagramFollowers, suffix: '+', label: s.counters.followers },
];
const fmt = (n: number) => new Intl.NumberFormat(locale).format(n);
---

<!-- Overlaps the hero's bottom edge (negative margin). -->
<section data-overlap class="relative z-10 -mt-24" aria-label={s.counters.cityLabel}>
  <div class="container-page">
  <div data-reveal class="bg-surface shadow-[0_0_0_6px_var(--halo),0_10px_24px_-20px_rgb(10_10_128/0.35)] grid grid-cols-1 lg:grid-cols-[1fr_1fr_1.5fr] divide-y lg:divide-y-0 lg:divide-x divide-line">
    {
      items.map((item) => (
        <div class="py-8 lg:py-10 px-6 lg:px-10">
          <p class="font-display text-5xl md:text-6xl text-accent-strong leading-none">
            <!-- An invisible copy of the final value reserves the width, so counting up doesn't shift the layout. -->
            <span class="inline-grid tabular-nums">
              <span class="invisible [grid-area:1/1]" aria-hidden="true">{fmt(item.value)}</span>
              <span class="[grid-area:1/1]" data-count={item.value} data-locale={locale}>{fmt(item.value)}</span>
            </span>
            {item.suffix}
          </p>
          <p class="mt-3 text-sm text-graphite">{item.label}</p>
        </div>
      ))
    }
    <div class="py-8 lg:py-10 px-6 lg:px-10">
      <p class="font-display text-4xl xl:text-5xl text-accent-strong leading-none">{s.counters.city}</p>
      <p class="mt-3 text-sm text-graphite">{s.counters.cityLabel}</p>
    </div>
  </div>
  </div>
</section>

<script>
  // The final value is already in the HTML, so this only animates it — SEO- and no-JS-safe.
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (els.length && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count);
          const nf = new Intl.NumberFormat(el.dataset.locale);
          const start = performance.now();
          const duration = 1600;
          const step = (now: number) => {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = nf.format(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.5 }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
