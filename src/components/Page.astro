---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import HeroVideo from './HeroVideo.astro';
import Services from './Services.astro';
import Projects from './Projects.astro';
import ValuationCta from './ValuationCta.astro';
import Areas from './Areas.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import type { Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Nav lang={lang} />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <HeroVideo lang={lang} />
    <!-- TODO(client): add <Counters> back once there are verified figures (see Counters.astro). -->
    <Services lang={lang} />
    <Projects lang={lang} />
    <ValuationCta lang={lang} />
    <Areas lang={lang} />
    <About lang={lang} />
    <!-- TODO(client): add <Testimonials> back once real Google reviews are in i18n testimonials.items. -->
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFab lang={lang} />
</Base>
