---
import { t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<section class="bg-brand text-white on-dark relative overflow-hidden">
  <!-- The signature M stroke again, drawn by scroll position (static where scroll timelines are unsupported). -->
  <svg
    viewBox="0 0 100 100"
    aria-hidden="true"
    focusable="false"
    class="m-scroll absolute right-[-6%] top-1/2 -translate-y-1/2 w-[70%] max-w-[760px] text-white/15 pointer-events-none"
  >
    <path d="M8 76 L33 24 L50 58 L67 24 L92 76" pathLength="1" fill="none" stroke="currentColor" stroke-width="0.6" />
  </svg>
  <div class="container-page section-y relative">
    <h2 class="max-w-2xl text-[clamp(2.25rem,5vw,4.25rem)]" data-reveal>{s.valuation.title}</h2>
    <p class="mt-5 max-w-xl text-white/85" data-reveal>{s.valuation.text}</p>
    <div class="mt-10" data-reveal>
      <a
        href="#iletisim"
        data-request-preset="consult:valuation"
        class="btn bg-white text-brand hover:text-white [--btn-sweep:var(--color-ink)]">{s.valuation.cta}</a
      >
    </div>
  </div>
</section>

